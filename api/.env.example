# Server configuration
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Use DOMAIN if you want to specify a full domain name instead of HOST:PORT
# DOMAIN=example.com

# Set to true to use HTTPS/WSS instead of HTTP/WS
USE_SSL=false

# Chrome/CDP configuration
CHROME_HEADLESS=true
CHROME_EXECUTABLE_PATH=
CHROME_ARGS=
# Bundled nginx listens on 9223; the standalone code default is 9222.
CDP_REDIRECT_PORT=9223
# CDP_DOMAIN=example.com:9223

# Session pool: creation returns 429 immediately by default when all slots are busy.
MAX_SESSIONS=1
SESSION_QUEUE_TIMEOUT_MS=0
SESSION_QUEUE_MAX_MS=600000
# Lifetime/idle expiry are opt-in; eligible sessions park instead of losing state.
SESSION_TIMEOUT_MS=0
SESSION_IDLE_TIMEOUT_MS=0
SESSION_EXPIRE_ACTION=park
SESSION_REAPER_INTERVAL_MS=10000
SESSION_PREEMPT_IDLE_MS=0
PARKED_TTL_MS=604800000
PARKED_MAX=20
SHUTDOWN_PARK_TIMEOUT_MS=20000
# Default passive CDP traffic that does not reset idle time (Method:type filters params.type).
IDLE_IGNORED_CDP_METHODS=Page.screencastFrameAck,Input.dispatchMouseEvent:mouseMoved,Target.getTargets,Browser.getVersion,Target.setDiscoverTargets,Page.startScreencast,Page.stopScreencast,Page.enable,Runtime.enable
CDP_PORT_BASE=9222
CDP_RESERVED_PORTS=9223
# Load the bundled rrweb recorder in headless Chrome only when explicitly enabled.
RRWEB_RECORDING=false

# Optional proxy configuration
PROXY_URL=

# Logging
LOG_LEVEL=warn # fatal, error, warn, info, debug, trace
ENABLE_CDP_LOGGING=false
LOG_CUSTOM_EMIT_EVENTS=false
ENABLE_VERBOSE_LOGGING=false

# Other configuration options
# Legacy compatibility setting; scoped commands are now always registered and
# protected by verified ownership and control leases (docs/NEXT-PLATFORM.md).
ENABLE_COMMANDS_API=false
SKIP_FINGERPRINT_INJECTION=false
DEFAULT_TIMEZONE=
DEFAULT_HEADERS=

# Persistent platform state. Mount this directory and keep the key across redeploys.
# JSON/JSONL and saved-cookie sidecars use STEEL_DATA_KEY, falling back to COOKIE_LIBRARY_KEY.
# Raw Chrome profiles, downloads and JPEGs remain ordinary protected volume files.
STEEL_DATA_DIR=./data
# STEEL_DATA_KEY=provide-through-a-secret-binding
# COOKIE_LIBRARY_DIR=./cookie-library
# COOKIE_LIBRARY_KEY=provide-through-a-secret-binding
# BROWSER_PROFILES_DIR=./browser-profiles
FILES_RETENTION_HOURS=72
AUDIT_RETENTION_DAYS=180
MIN_FREE_MEMORY_MB=0
BACKGROUND_MAX_SESSIONS=1
# STEEL_VIEWER_URL=https://steel.example.com
# NOTIFY_WEBHOOK_URL=https://automation.example.com/api/webhook/SECRET

# Egress: direct, a configured named proxy, or nordvpn[:COUNTRY] with credentials.
DEFAULT_EGRESS=direct
EGRESS_PROFILES={}
# EGRESS_PROFILES={"home":{"proxyUrl":"http://USER:PASSWORD@proxy.example.com:3128","label":"Home"}}
# NORDVPN_SERVICE_USER=provide-through-a-secret-binding
# NORDVPN_SERVICE_PASS=provide-through-a-secret-binding

# Login checks: scheduler runs every 10 min; checks default to every 24 hours.
COOKIE_EXPIRY_WARN_DAYS=3
# Empty means any time. Example nightly UTC window: 23:00-02:00
COOKIE_CHECK_WINDOW=

# Timeline and opt-in CDP JPEG recording, independent of RRWEB_RECORDING.
TIMELINE_RETENTION_DAYS=7
RECORDING_FPS_MAX=2
RECORDING_MAX_WIDTH=1280
RECORDING_JPEG_QUALITY=60
RECORDING_MAX_MB_PER_SESSION=300
RECORDING_TOTAL_MAX_MB=4000
RECORDING_RETENTION_DAYS=7

# Structured extraction and LLM watchers: OpenAI-compatible base, including /v1.
# LLM_BASE_URL=https://llm.example.com/v1
# LLM_API_KEY=provide-through-a-secret-binding
LLM_MODEL=spark
LLM_TIMEOUT_MS=45000
EXTRACT_MAX_CHARS=100000
# New extraction/watcher jobs reject private destinations; opt in only for intranet use.
EXTRAS_ALLOW_PRIVATE_NETWORKS=false
WATCHER_INTERVAL_MS=30000
EXTENSION_MAX_MB=25

# Verified caller and human/agent control. Omission is local single-user mode.
# Strong bearer token -> {"id":"canonical-principal","role":"agent"|"operator"}.
# STEEL_AUTH_KEYS=provide-json-through-a-secret-binding
# Agent gateway proof and human gateway proof must be distinct (minimum24chars).
# STEEL_TRUST_PROXY_SECRET=provide-through-a-secret-binding
# STEEL_OPERATOR_PROXY_SECRET=provide-through-a-secret-binding
# STEEL_OPERATORS=operator@example.com

# Owned browser-origin diagnostics. Missing collectors are reported as untested.
# STEEL_DIAGNOSTICS_COLLECTOR=https://collector.example.com
# STEEL_DIAGNOSTICS_IPV6_COLLECTOR=https://ipv6-collector.example.com
# STEEL_DIAGNOSTICS_STUN_URL=stun:stun.example.com:3478
# STEEL_DNS_DIAGNOSTICS_URL=http://owned-private-dns-collector:8053
# STEEL_DNS_DIAGNOSTICS_TOKEN=provide-through-a-secret-binding

# Approved secret references and named local document destinations, not values.
# See docs/DATA-WORKSPACE.md for schemas, client/origin restrictions and mounts.
STEEL_VAULT_REFERENCES={}
STEEL_ARTIFACT_DESTINATIONS={}

# Regression replay can navigate only these exact owned origins.
# STEEL_REPLAY_ORIGINS=https://owned-fixture.example.com
STEEL_REPLAY_ALLOW_PRIVATE_NETWORKS=false
# STEEL_BUILD_REVISION is supplied by the tested image release/deployment.
